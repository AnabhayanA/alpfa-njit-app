# DRIVE_FOLDER_ID: the ID of the Google Drive folder to upload photos into.
DRIVE_FOLDER_ID=

# GOOGLE_SERVICE_ACCOUNT_JSON: paste the full contents of the service account
# JSON key file here (as one line), or a base64-encoded version of it.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional: shared secret the app must send as the `x-api-key` header.
# Strongly recommended before deploying publicly — without it, anyone who
# finds the /upload URL can post photos to your Drive (rate limiting still
# applies either way).
UPLOAD_API_KEY=

# Optional: comma-separated list of web origins allowed to call this API
# (e.g. "https://your-app.example.com"). Leave blank if you only ship native
# apps (iOS/Android), since browser CORS doesn't apply to them.
ALLOWED_ORIGINS=
