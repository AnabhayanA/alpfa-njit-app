{
  "expo": {
    "name": "ALPFA NJIT",
    "slug": "alpfa-njit-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/ALPFANJITLOGO.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.alpfanjit.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/ALPFANJITLOGO.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/images/ALPFANJITLOGO.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#6E1B2D"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow ALPFA NJIT to access your camera to share photos to the chapter's Google Drive."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ALPFA NJIT to access your photos so you can choose images to share with the chapter."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow ALPFA NJIT to use your location when you choose to add a location to a photo."
        }
      ],
      "expo-font",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "ec2f7739-7d6c-44e8-aaf1-6af5ad57adf1"
      }
    },
    "owner": "ana_vamp"
  }
}
